# Env vars baked into the app bundle at build time (Expo inline environment).
# The cloud build reads these from GitHub Actions secrets — see README.
# Local builds: copy this file to `.env` and fill in your keys.
#
# ⚠️ Never commit a real .env — keys ship inside the IPA/bundle.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_OPENROUTER_API_KEY=
