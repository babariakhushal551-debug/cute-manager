{
  "expo": {
    "name": "Curio",
    "slug": "curio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "curio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freecuff.curio",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Curio lets you attach screenshots and photos to your inbox so the AI can understand them.",
        "NSPhotoLibraryAddUsageDescription": "Curio can save images you choose back to your photo library.",
        "NSMicrophoneUsageDescription": "Curio records voice notes only when you tap the microphone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.freecuff.curio",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/curio-share",
      "expo-image",
      "expo-asset",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
